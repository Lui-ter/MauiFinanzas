<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="MovilL.AppShell"
       Shell.FlyoutBehavior="Disabled">

    <ShellContent x:Name="LoginShellContent"
                  Title="Login"
                  Route="LoginPage"
                  Shell.NavBarIsVisible="False"
                  Shell.TabBarIsVisible="False"/>

    <TabBar Shell.TabBarIsVisible="False">
        <ShellContent x:Name="InicioShellContent"
                      Title="Home"
                      Route="Inicio"/>
        <ShellContent x:Name="MovimientoShellContent"
                      Title="Nuevo"
                      Route="NuevoMovimientoPage"/>
        <ShellContent x:Name="ResumenShellContent"
                      Title="Resumen"
                      Route="ResumenPage"/>
    </TabBar>

</Shell>