<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilL.views.Navegador">

    <Border BackgroundColor="#1A1D29"
            Stroke="#2B3042"
            StrokeThickness="1"
            Padding="10, 1, 5, 5"
            Margin="0"
            HorizontalOptions="Fill"
            VerticalOptions="End">

        <Grid ColumnDefinitions="*, *, *"
              ColumnSpacing="10"
              VerticalOptions="Center">

            <!-- Opción: Home -->
            <Grid x:Name="TabHome"
                  Grid.Column="0"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="2"
                  Padding="8, 6"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped"/>
                </Grid.GestureRecognizers>

                <Label x:Name="IconHome"
                       Grid.Row="0"
                       Text="🏠"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label x:Name="TextHome"
                       Grid.Row="1"
                       Text="Home"
                       FontSize="12"
                       TextColor="#8E95A5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

            <!-- Opción: Movimiento -->
            <Grid x:Name="TabMovimiento"
                  Grid.Column="1"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="2"
                  Padding="8, 6"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMovimientoTapped"/>
                </Grid.GestureRecognizers>

                <Label x:Name="IconMovimiento"
                       Grid.Row="0"
                       Text="➕"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label x:Name="TextMovimiento"
                       Grid.Row="1"
                       Text="Movimiento"
                       FontSize="12"
                       TextColor="#8E95A5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

            <!-- Opción: Resumen -->
            <Grid x:Name="TabResumen"
                  Grid.Column="2"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="2"
                  Padding="8, 6"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResumenTapped"/>
                </Grid.GestureRecognizers>

                <Label x:Name="IconResumen"
                       Grid.Row="0"
                       Text="📊"
                       FontSize="20"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label x:Name="TextResumen"
                       Grid.Row="1"
                       Text="Resumen"
                       FontSize="12"
                       TextColor="#8E95A5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Grid>

        </Grid>
    </Border>

</ContentView>

