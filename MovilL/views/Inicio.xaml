<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.Inicio"
             Title="Inicio"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0B1020">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid" RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,26"
                                 Spacing="22"
                                 MaximumWidthRequest="760"
                                 HorizontalOptions="Center">

                <VerticalStackLayout Spacing="6">
                    <Label Text="TU ESPACIO FINANCIERO"
                           FontSize="10"
                           CharacterSpacing="1.4"
                           FontAttributes="Bold"
                           TextColor="#68E0A3"/>
                    <Label x:Name="LabelSaludo"
                           Text="¡Bienvenido a MovilL!"
                           FontSize="29"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Organiza tus finanzas, un movimiento a la vez."
                           FontSize="14"
                           TextColor="#A6B1C5"/>
                </VerticalStackLayout>

                <Border BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 22"
                        Padding="20">
                    <Grid ColumnDefinitions="*, Auto"
                          RowDefinitions="Auto, Auto"
                          ColumnSpacing="12"
                          RowSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Lleva el control de tu día"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Registra ingresos y gastos para mantener tu actividad al día."
                                   FontSize="13"
                                   TextColor="#A6B1C5"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                WidthRequest="46"
                                HeightRequest="46"
                                BackgroundColor="#173C32"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                VerticalOptions="Start">
                            <Label Text="＋"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="#68E0A3"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Button Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="Registrar movimiento"
                                Clicked="OnIrAMovimientoClicked"
                                BackgroundColor="#49CE8D"
                                TextColor="#0B2018"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="14"/>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Actividad reciente"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Tus últimos movimientos"
                                   FontSize="12"
                                   TextColor="#8491A7"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Ver resumen  →"
                                Clicked="OnIrAResumenClicked"
                                BackgroundColor="Transparent"
                                TextColor="#68E0A3"
                                FontSize="12"
                                FontAttributes="Bold"
                                Padding="8,6"
                                VerticalOptions="Center"/>
                    </Grid>

                    <CollectionView x:Name="ListaMovimientosRecientes"
                                    HeightRequest="264"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="#141B2B"
                                    Stroke="#28334B"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="22">
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="7">
                                    <Label Text="Todavía no hay movimientos"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="Cuando registres uno, aparecerá aquí."
                                           FontSize="12"
                                           TextColor="#8491A7"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#141B2B"
                                        Stroke="#28334B"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="12"
                                          VerticalOptions="Center">
                                        <Border WidthRequest="40"
                                                HeightRequest="40"
                                                BackgroundColor="#1B2639"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 13">
                                            <Label Text="{Binding Icono}"
                                                   FontSize="19"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="3"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Categoria}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="White"/>
                                            <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="11"
                                                   TextColor="#8491A7"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding MontoFormateado}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{Binding ColorTipo}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <views:Navegador Grid.Row="1" PaginaActiva="Home"/>
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>
    </Grid>
</ContentPage>
