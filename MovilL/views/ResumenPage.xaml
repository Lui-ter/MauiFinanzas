<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MovilL.Views.Controls"
             x:Class="MovilL.views.ResumenPage"
             Title="Resumen">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="👤" Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid">

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="Tu resumen"
                       FontSize="24"
                       FontAttributes="Bold"/>

                <!-- PANEL SUPERIOR: 2 COLUMNAS (MÉTRICAS + GRÁFICA) -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                    <!-- Columna Izquierda: Tarjetas de Totales -->
                    <VerticalStackLayout Grid.Column="0" Spacing="10">

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <!-- Ingresos -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#1B3B2A"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    Padding="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="↑ Ingresos" FontSize="12" TextColor="#81C784"/>
                                    <Label x:Name="LabelIngresos" Text="$0" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Gastos -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#3B1E1E"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="Transparent"
                                    Padding="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="↓ Gastos" FontSize="12" TextColor="#E57373"/>
                                    <Label x:Name="LabelGastos" Text="$0" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Balance Actual -->
                        <Border BackgroundColor="#1E2A3B"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                Padding="16">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Balance actual" FontSize="12" TextColor="#90CAF9"/>
                                <Label x:Name="LabelBalance" Text="$0" FontSize="26" FontAttributes="Bold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Columna Derecha: Tarjeta de Gráfica -->
                    <Border Grid.Column="1" 
                            BackgroundColor="#1E202C" 
                            StrokeShape="RoundRectangle 12" 
                            Stroke="#2D3042" 
                            Padding="15">
                        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                            <Label Text="Distribución por categoría" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="White" 
                                   HorizontalOptions="Center"/>

                            <!-- Gráfica visual renderizada en MAUI -->
                            <GraphicsView x:Name="GraficaDonaView" 
                                          HeightRequest="110" 
                                          WidthRequest="110" 
                                          HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <!-- LISTA DE MOVIMIENTOS RECIENTES -->
                <Label Text="Movimientos recientes"
                       FontSize="18"
                       FontAttributes="Bold"
                       Margin="0,5,0,0"/>

                <CollectionView x:Name="ListaMovimientos">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" Padding="0,30" Spacing="6">
                            <Label Text="📭" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="Aún no hay movimientos registrados"
                                   TextColor="#9E9E9E"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#2A2A3A"
                                    BackgroundColor="#20202E"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto, *, Auto">

                                    <!-- Icono dinámico según categoría -->
                                    <Border Grid.Column="0" 
                                            BackgroundColor="#2B2D3C" 
                                            StrokeShape="RoundRectangle 8" 
                                            WidthRequest="40" 
                                            HeightRequest="40" 
                                            Margin="0,0,12,0" 
                                            Stroke="Transparent">
                                        <Label Text="{Binding Icono}" 
                                               FontSize="18" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center"/>
                                    </Border>

                                    <!-- Detalles -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Categoria}" FontAttributes="Bold" TextColor="White" FontSize="14"/>
                                        <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                               FontSize="11" TextColor="#9E9E9E"/>
                                    </VerticalStackLayout>

                                    <!-- Monto -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Monto, StringFormat='{0:C}'}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           VerticalOptions="Center"
                                           TextColor="{Binding Tipo, Converter={StaticResource TipoAColorConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <controls:UsuarioPanelView x:Name="PanelUsuario"/>

    </Grid>
</ContentPage>