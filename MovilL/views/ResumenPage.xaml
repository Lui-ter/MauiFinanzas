<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.ResumenPage"
             Title="Resumen"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#12141D">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid" RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0" Orientation="Vertical">
            <VerticalStackLayout Padding="16, 12" Spacing="16" HorizontalOptions="Fill">

                <!-- Encabezado de página -->
                <VerticalStackLayout Spacing="4" Margin="2, 6, 2, 2">
                    <Label Text="Resumen Financiero"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Estado de tu balance y registro de movimientos"
                           FontSize="13"
                           TextColor="#8E95A5"/>
                </VerticalStackLayout>

                <!-- TARJETA PRINCIPAL: BALANCE GENERAL -->
                <Border BackgroundColor="#1A1D29"
                        Stroke="#2E354A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="18">
                    <VerticalStackLayout Spacing="16">

                        <!-- Balance Actual Hero -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BALANCE ACTUAL"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#90CAF9"/>
                            <Label x:Name="LabelBalance"
                                   Text="$0.00"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </VerticalStackLayout>

                        <!-- Fila con Ingresos y Gastos E57373  -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- Tarjeta Ingresos -->
                            <Border Grid.Column="0"
                                    BackgroundColor="#4E272E"
                                    Stroke="#4E272E"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14, 12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="↑ Ingresos" FontSize="12" FontAttributes="Bold" TextColor="#E57373"/>
                                    <Label x:Name="LabelIngresos" Text="$0.00" FontSize="17" FontAttributes="Bold" TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tarjeta Gastos -->
                            <Border Grid.Column="1"
                                    BackgroundColor="#254A37"
                                    Stroke="#254A37"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14, 12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="↓ Gastos" FontSize="12" FontAttributes="Bold" TextColor="#81C784"/>
                                    <Label x:Name="LabelGastos" Text="$0.00" FontSize="17" FontAttributes="Bold" TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- TARJETA: GRÁFICA DE DISTRIBUCIÓN -->
                <Border BackgroundColor="#1A1D29"
                        Stroke="#2E354A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PROPORCIÓN INGRESOS VS GASTOS"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#8E95A5"/>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="18" VerticalOptions="Center">
                            <!-- Gráfica visual renderizada en MAUI  -->
                            <GraphicsView Grid.Column="0"
                                          x:Name="GraficaDonaView" 
                                          HeightRequest="120" 
                                          WidthRequest="120" 
                                          VerticalOptions="Center"
                                          HorizontalOptions="Center"/>

                            <!-- Leyenda informativa -->
                            <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" Color="#81C784" CornerRadius="6" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Gastos" FontSize="13" TextColor="White" VerticalOptions="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" Color="#E57373" CornerRadius="6" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Ingresos" FontSize="13" TextColor="White" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN: LISTA DE MOVIMIENTOS RECIENTES -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="MOVIMIENTOS RECIENTES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#8E95A5"
                           Margin="2, 4, 2, 0"/>

                    <CollectionView x:Name="ListaMovimientos">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="#1A1D29"
                                    Stroke="#2E354A"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="24">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label Text="📭" FontSize="36" HorizontalOptions="Center"/>
                                    <Label Text="Aún no hay movimientos registrados"
                                           TextColor="#8E95A5"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 14"
                                        Stroke="#293043"
                                        StrokeThickness="1"
                                        BackgroundColor="#1A1D29"
                                        Padding="14, 12"
                                        Margin="0, 0, 0, 10">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                        <!-- Icono dinámico según categoría -->
                                        <Border Grid.Column="0" 
                                                BackgroundColor="#242B3C" 
                                                StrokeShape="RoundRectangle 10" 
                                                WidthRequest="42" 
                                                HeightRequest="42" 
                                                Stroke="Transparent"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Icono}" 
                                                   FontSize="20" 
                                                   HorizontalOptions="Center" 
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Detalles -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Categoria}" FontAttributes="Bold" TextColor="White" FontSize="14"/>
                                            <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="12" TextColor="#8E95A5"/>
                                        </VerticalStackLayout>

                                        <!-- Monto -->
                                        <Label Grid.Column="2"
                                               Text="{Binding MontoFormateado}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               VerticalOptions="Center"
                                               TextColor="{Binding ColorTipo}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegación inferior -->
        <views:Navegador Grid.Row="1" PaginaActiva="Resumen"/>

        <!-- Menú lateral de usuario flotante -->
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>

    </Grid>
</ContentPage>