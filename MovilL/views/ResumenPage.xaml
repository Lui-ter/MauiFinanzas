<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.ResumenPage"
             Title="Resumen"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0B1020">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid" RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0" Orientation="Vertical">
            <VerticalStackLayout Padding="16, 12" Spacing="16" HorizontalOptions="Fill">

                <!-- Encabezado de página -->
                <VerticalStackLayout Spacing="4" Margin="2, 6, 2, 2">
                    <Label Text="Resumen Financiero"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Estado de tu balance y registro de movimientos"
                           FontSize="13"
                           TextColor="#8491A7"/>
                </VerticalStackLayout>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 26"
                        Padding="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1D654A" Offset="0"/>
                            <GradientStop Color="#173C32" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*, Auto"
                          RowDefinitions="Auto, Auto"
                          RowSpacing="10">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="BALANCE ACTUAL"
                                   FontSize="11"
                                   CharacterSpacing="1.5"
                                   FontAttributes="Bold"
                                   TextColor="#C5F4DC"/>
                            <Label x:Name="LabelBalance"
                                   Text="$0.00"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#264D3F"
                                Stroke="#5BBD8A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                VerticalOptions="Start">
                            <Label Text="$"
                                   FontSize="25"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Ingresos menos gastos registrados"
                               FontSize="13"
                               TextColor="#C5F4DC"/>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                    <Border BackgroundColor="#141B2B"
                            Stroke="#28334B"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="17">
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="34"
                                    HeightRequest="34"
                                    BackgroundColor="#173C32"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11">
                                <Label Text="↗"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#68E0A3"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Ingresos"
                                       FontSize="12"
                                       TextColor="#8491A7"/>
                                <Label x:Name="LabelIngresos"
                                       Text="$0.00"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#68E0A3"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#141B2B"
                            Stroke="#28334B"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="17">
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="34"
                                    HeightRequest="34"
                                    BackgroundColor="#3B2532"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 11">
                                <Label Text="↘"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#FF8585"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Gastos"
                                       FontSize="12"
                                       TextColor="#8491A7"/>
                                <Label x:Name="LabelGastos"
                                       Text="$0.00"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#FF8585"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- TARJETA: GRÁFICA DE DISTRIBUCIÓN -->
                <Border BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="PROPORCIÓN INGRESOS VS GASTOS"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#8491A7"/>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="18" VerticalOptions="Center">
                            <!-- Gráfica visual renderizada en MAUI  -->
                            <GraphicsView Grid.Column="0"
                                          x:Name="GraficaDonaView"
                                          HeightRequest="120"
                                          WidthRequest="120"
                                          VerticalOptions="Center"
                                          HorizontalOptions="Center"/>

                            <!-- Leyenda informativa -->
                            <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" Color="#FF8585" CornerRadius="6" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Gastos" FontSize="13" TextColor="White" VerticalOptions="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                    <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" Color="#68E0A3" CornerRadius="6" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="Ingresos" FontSize="13" TextColor="White" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- SECCIÓN: LISTA DE MOVIMIENTOS RECIENTES -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="MOVIMIENTOS RECIENTES"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#8491A7"
                           Margin="2, 4, 2, 0"/>

                    <CollectionView x:Name="ListaMovimientos">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="#141B2B"
                                    Stroke="#28334B"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="24">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label Text="📭" FontSize="36" HorizontalOptions="Center"/>
                                    <Label Text="Aún no hay movimientos registrados"
                                           TextColor="#8491A7"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 14"
                                        Stroke="#28334B"
                                        StrokeThickness="1"
                                        BackgroundColor="#141B2B"
                                        Padding="14, 12"
                                        Margin="0, 0, 0, 10">
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">

                                        <!-- Icono dinámico según categoría -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#1B2639"
                                                StrokeShape="RoundRectangle 10"
                                                WidthRequest="42"
                                                HeightRequest="42"
                                                Stroke="Transparent"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Icono}"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Detalles -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Categoria}" FontAttributes="Bold" TextColor="White" FontSize="14"/>
                                            <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="12" TextColor="#8491A7"/>
                                        </VerticalStackLayout>

                                        <!-- Monto -->
                                        <Label Grid.Column="2"
                                               Text="{Binding MontoFormateado}"
                                               FontAttributes="Bold"
                                               FontSize="15"
                                               VerticalOptions="Center"
                                               TextColor="{Binding ColorTipo}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegación inferior -->
        <views:Navegador Grid.Row="1" PaginaActiva="Resumen"/>

        <!-- Menú lateral de usuario flotante -->
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>

    </Grid>
</ContentPage>