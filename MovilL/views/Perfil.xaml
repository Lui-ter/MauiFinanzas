<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.Perfil"
             Title="Mi perfil"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0B1020">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,16" Spacing="16" MaximumWidthRequest="620" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="4" Margin="2,2,2,0">
                    <Label Text="Mi perfil"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Administra tu información personal y tu cuenta."
                           FontSize="13"
                           TextColor="#8491A7"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 22"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="18">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="88, *, Auto" ColumnSpacing="14">
                            <Border WidthRequest="82"
                                    HeightRequest="82"
                                    StrokeShape="RoundRectangle 41"
                                    Stroke="#49CE8D"
                                    StrokeThickness="2"
                                    BackgroundColor="#0E1524"
                                    Padding="2"
                                    VerticalOptions="Center">
                                <Image x:Name="ImgPerfil"
                                       Aspect="AspectFill"
                                       WidthRequest="78"
                                       HeightRequest="78"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label x:Name="LblNombreHeader"
                                       Text="Nombre de Usuario"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"/>
                                <Label x:Name="LblUsernameHeader"
                                       Text="@usuario"
                                       FontSize="13"
                                       TextColor="#68E0A3"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label x:Name="LblTipoCuenta"
                                       Text="Principal"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#68E0A3"
                                       HorizontalTextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#28334B"/>

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Actividad registrada"
                                       FontSize="12"
                                       TextColor="#8491A7"/>
                                <Label Text="Movimientos vinculados a tu perfil"
                                       FontSize="13"
                                       TextColor="#A6B1C5"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="16,8">
                                <Label x:Name="LblTotalMovimientos"
                                       Text="0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalTextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Información personal"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="Mantén tus datos actualizados."
                                   FontSize="12"
                                   TextColor="#8491A7"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre completo" FontSize="12" FontAttributes="Bold" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 11" BackgroundColor="#0E1524" Stroke="#303B53" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                                <Entry x:Name="EntryNombre"
                                       Placeholder="Tu nombre"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       FontSize="14"
                                       ReturnType="Next"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre de usuario" FontSize="12" FontAttributes="Bold" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 11" BackgroundColor="#0E1524" Stroke="#303B53" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                                <Entry x:Name="EntryUsername"
                                       Placeholder="@usuario"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       FontSize="14"
                                       ReturnType="Next"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 11" BackgroundColor="#0E1524" Stroke="#303B53" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                                <Entry x:Name="EntryCorreo"
                                       Placeholder="nombre@correo.com"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       FontSize="14"
                                       Keyboard="Email"
                                       ReturnType="Next"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Edad" FontSize="12" FontAttributes="Bold" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 11" BackgroundColor="#0E1524" Stroke="#303B53" StrokeThickness="1" Padding="12,0" HeightRequest="48">
                                <Entry x:Name="EntryEdad"
                                       Placeholder="Edad"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       FontSize="14"
                                       Keyboard="Numeric"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 11"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Entry x:Name="EntryContrasena"
                                           Placeholder="Contraseña"
                                           PlaceholderColor="#71809A"
                                           TextColor="White"
                                           FontSize="14"
                                           IsPassword="True"
                                           VerticalOptions="Center"/>
                                    <Button x:Name="BtnToggleContrasena"
                                            Grid.Column="1"
                                            Text="Mostrar"
                                            FontSize="11"
                                            TextColor="#68E0A3"
                                            BackgroundColor="Transparent"
                                            Padding="6,0"
                                            HeightRequest="36"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleContrasenaClicked"/>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <Label x:Name="LabelMensajePerfil"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#68E0A3"
                               IsVisible="False"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"/>

                        <Button x:Name="BtnGuardarCambios"
                                Text="Guardar cambios"
                                BackgroundColor="#49CE8D"
                                TextColor="#0B2018"
                                FontAttributes="Bold"
                                FontSize="14"
                                CornerRadius="12"
                                HeightRequest="50"
                                Clicked="OnGuardarCambiosClicked"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Administrar cuenta"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Revierte cambios pendientes o administra el estado de tu cuenta."
                               FontSize="12"
                               TextColor="#8491A7"
                               LineBreakMode="WordWrap"/>

                        <Button x:Name="BtnRegistrarPermanente"
                                Text="Crear cuenta permanente"
                                BackgroundColor="#287A56"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="11"
                                HeightRequest="46"
                                IsVisible="False"
                                Clicked="OnRegistrarPermanenteClicked"/>

                        <Button Text="Descartar cambios"
                                BackgroundColor="#0E1524"
                                TextColor="#8CC8FF"
                                BorderColor="#303B53"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="11"
                                HeightRequest="44"
                                Clicked="OnRestablecerValoresClicked"/>

                        <Button Text="Eliminar cuenta y datos"
                                BackgroundColor="#30202A"
                                TextColor="#FF8585"
                                BorderColor="#673945"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="11"
                                HeightRequest="44"
                                Clicked="OnEliminarCuentaClicked"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <views:Navegador Grid.Row="1" PaginaActiva=""/>
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>
    </Grid>
</ContentPage>
