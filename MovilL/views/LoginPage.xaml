<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilL.views.LoginPage">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="15" Spacing="16" WidthRequest="521" HorizontalOptions="Center">

            <Label Text="Gestión Financiera Personal"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Inicia sesión para continuar"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   Opacity="0.6"
                   Margin="0,0,0,16"/>

            <Border Stroke="#4CAF50"
                    StrokeThickness="1"
                    Padding="12,0"
                    HeightRequest="52"
                    StrokeShape="RoundRectangle 12">
                <Entry x:Name="EntryUsuario"
                       Placeholder="Usuario"
                       VerticalOptions="Center"/>
            </Border>

            <Border Stroke="#4CAF50"
                    StrokeThickness="1"
                    Padding="12,0"
                    HeightRequest="52"
                    StrokeShape="RoundRectangle 12">
                <Entry x:Name="EntryContrasena"
                       Placeholder="Contraseña"
                       IsPassword="True"
                       VerticalOptions="Center"/>
            </Border>

            <Label x:Name="LabelError"
                   TextColor="Red"
                   FontSize="13"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   Text="Usuario o contraseña incorrectos"/>

            <Button Text="Iniciar sesión"
                    Clicked="OnIniciarSesionClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="12"
                    Margin="0,8,0,0"/>

            <Button Text="Entrar como invitado"
                    Clicked="OnEntrarInvitadoClicked"
                    BackgroundColor="Transparent"
                    TextColor="#4CAF50"
                    BorderColor="#4CAF50"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="12"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>