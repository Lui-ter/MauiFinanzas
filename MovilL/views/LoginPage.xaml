<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovilL.views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1020">

    <Grid>
        <Ellipse WidthRequest="260"
                 HeightRequest="260"
                 Fill="#173B37"
                 Opacity="0.42"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 TranslationX="105"
                 TranslationY="-125"/>
        <Ellipse WidthRequest="190"
                 HeightRequest="190"
                 Fill="#25294A"
                 Opacity="0.32"
                 HorizontalOptions="Start"
                 VerticalOptions="End"
                 TranslationX="-90"
                 TranslationY="80"/>

        <ScrollView VerticalOptions="Fill">
            <VerticalStackLayout Padding="24,36"
                                 Spacing="24"
                                 MaximumWidthRequest="480"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">

                <VerticalStackLayout Spacing="20">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="50"
                                HeightRequest="50"
                                StrokeThickness="0"
                                BackgroundColor="#173C32"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="$"
                                   FontSize="27"
                                   FontAttributes="Bold"
                                   TextColor="#68E0A3"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="MovilL"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="FINANZAS PERSONALES"
                                   FontSize="10"
                                   CharacterSpacing="1.5"
                                   FontAttributes="Bold"
                                   TextColor="#8D9AAF"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Tu dinero,&#10;con más claridad."
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="White"
                               LineHeight="1.05"/>
                        <Label Text="Organiza tus ingresos y gastos en un solo lugar."
                               FontSize="15"
                               TextColor="#A6B1C5"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="24">
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,16"
                                Radius="24"
                                Opacity="0.28"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="BIENVENIDO DE NUEVO"
                                   FontSize="10"
                                   CharacterSpacing="1.4"
                                   FontAttributes="Bold"
                                   TextColor="#68DCA0"/>
                            <Label Text="Inicia sesión"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Usuario"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C5CDDA"/>
                            <Border BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14,0"
                                    HeightRequest="54">
                                <Entry x:Name="EntryUsuario"
                                       Placeholder="Escribe tu usuario"
                                       TextColor="White"
                                       PlaceholderColor="#71809A"
                                       ReturnType="Next"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="Contraseña"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C5CDDA"/>
                            <Border BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14,0"
                                    HeightRequest="54">
                                <Entry x:Name="EntryContrasena"
                                       Placeholder="Escribe tu contraseña"
                                       TextColor="White"
                                       PlaceholderColor="#71809A"
                                       IsPassword="True"
                                       ReturnType="Go"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <Label x:Name="LabelError"
                               TextColor="#FF8585"
                               FontSize="13"
                               IsVisible="False"
                               HorizontalTextAlignment="Center"
                               Text="Usuario o contraseña incorrectos"/>

                        <Button Text="Iniciar sesión"
                                Clicked="OnIniciarSesionClicked"
                                BackgroundColor="#49CE8D"
                                TextColor="#0B2018"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="54"
                                CornerRadius="14"
                                Margin="0,2,0,0"/>

                        <Grid ColumnDefinitions="*,Auto,*"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <BoxView HeightRequest="1"
                                     Color="#303B53"
                                     VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="o continúa como"
                                   FontSize="12"
                                   TextColor="#8491A7"
                                   VerticalOptions="Center"/>
                            <BoxView Grid.Column="2"
                                     HeightRequest="1"
                                     Color="#303B53"
                                     VerticalOptions="Center"/>
                        </Grid>

                        <Button Text="Entrar como invitado"
                                Clicked="OnEntrarInvitadoClicked"
                                BackgroundColor="Transparent"
                                TextColor="#D3DBE8"
                                BorderColor="#3A4660"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="50"
                                CornerRadius="14"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Un paso a la vez. Mejor control de tus finanzas."
                       FontSize="12"
                       TextColor="#78869D"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
