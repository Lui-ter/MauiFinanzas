<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.NuevoMovimientoPage"
             Title="Nuevo movimiento"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#12141D">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid" RowDefinitions="*, Auto">

        <!-- Contenido scrolleable responsivo garantizado para pantallas móviles -->
        <ScrollView Grid.Row="0" Orientation="Vertical" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Fill" Padding="16, 12">

                <!-- Título y subtítulo -->
                <VerticalStackLayout Spacing="4" Margin="2, 4, 2, 0" HorizontalOptions="Fill">
                    <Label Text="Nuevo Movimiento"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Registra tus ingresos o gastos con vista previa instantánea"
                           FontSize="13"
                           TextColor="#8E95A5"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <!-- TARJETA: FORMULARIO -->
                <Border StrokeShape="RoundRectangle 18" 
                        BackgroundColor="#1A1D29" 
                        Stroke="#2E354A" 
                        StrokeThickness="1" 
                        Padding="16"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">

                        <Label Text="DETALLES DE LA OPERACIÓN"
                               FontAttributes="Bold"
                               FontSize="11"
                               TextColor="#81C784"
                               Margin="2,0"/>

                        <!-- Tipo de movimiento -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Tipo de movimiento" FontAttributes="Bold" FontSize="13" TextColor="#B0B5C6"/>
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#222738" 
                                    Stroke="#353D54" 
                                    StrokeThickness="1" 
                                    Padding="12,0" 
                                    HeightRequest="48" 
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Picker x:Name="PickerTipo" 
                                        FontSize="14" 
                                        TextColor="White" 
                                        TitleColor="#8E95A5" 
                                        HorizontalOptions="Fill" 
                                        VerticalOptions="Center" 
                                        SelectedIndexChanged="OnTipoChanged">
                                    <Picker.Items>
                                        <x:String>Ingreso</x:String>
                                        <x:String>Gasto</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Categoría -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Categoría" FontAttributes="Bold" FontSize="13" TextColor="#B0B5C6"/>
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#222738" 
                                    Stroke="#353D54" 
                                    StrokeThickness="1" 
                                    Padding="12,0" 
                                    HeightRequest="48" 
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Picker x:Name="PickerCategoria"                  
                                        ItemDisplayBinding="{Binding Nombre}"
                                        FontSize="14"
                                        TextColor="White"
                                        TitleColor="#8E95A5"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Monto -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Monto ($)" FontAttributes="Bold" FontSize="13" TextColor="#B0B5C6"/>
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#222738" 
                                    Stroke="#353D54" 
                                    StrokeThickness="1" 
                                    Padding="12,0" 
                                    HeightRequest="48" 
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Entry x:Name="EntryMonto"
                                       Placeholder="0.00"
                                       PlaceholderColor="#6E768E"
                                       TextColor="White"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Center"
                                       TextChanged="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fecha -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Fecha" FontAttributes="Bold" FontSize="13" TextColor="#B0B5C6"/>
                            <Border StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#222738" 
                                    Stroke="#353D54" 
                                    StrokeThickness="1" 
                                    Padding="12,0" 
                                    HeightRequest="48" 
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <DatePicker x:Name="DatePickerFecha"
                                            TextColor="White"
                                            FontSize="14"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            DateSelected="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Mensaje de estado -->
                        <Label x:Name="LabelMensaje"
                               TextColor="#4CAF50"
                               FontSize="13"
                               FontAttributes="Bold"
                               IsVisible="False"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               Margin="0, 4, 0, 0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- TARJETA: VISTA PREVIA Y CONFIRMACIÓN -->
                <Border StrokeShape="RoundRectangle 18" 
                        BackgroundColor="#1A1D29" 
                        Stroke="#2E354A" 
                        StrokeThickness="1" 
                        Padding="16"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">

                        <Grid ColumnDefinitions="*, Auto" HorizontalOptions="Fill">
                            <Label Text="VISTA PREVIA EN VIVO"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="#8E95A5"
                                   VerticalOptions="Center"/>
                            <Label x:Name="LabelPreviewTipo" 
                                   Grid.Column="1"
                                   Text="INGRESO" 
                                   FontAttributes="Bold" 
                                   FontSize="13" 
                                   TextColor="#4CAF50"
                                   HorizontalOptions="End"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Cuadro con la Imagen ocupando todo el ancho de forma responsiva -->
                        <Border x:Name="BorderIcono" 
                                StrokeShape="RoundRectangle 14" 
                                BackgroundColor="#222738" 
                                Stroke="#4CAF50" 
                                StrokeThickness="2" 
                                HeightRequest="140"
                                MinimumHeightRequest="140"
                                MaximumHeightRequest="140"
                                HorizontalOptions="Fill"
                                Padding="0">
                            <Grid HeightRequest="140" HorizontalOptions="Fill" IsClippedToBounds="True">
                                <Image x:Name="ImagePreviewCategoria"
                                       Aspect="AspectFill"
                                       HeightRequest="140"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"/>

                                <!-- Barra inferior con el nombre de la categoría -->
                                <Border VerticalOptions="End"
                                        BackgroundColor="#E6161924"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 0,0,12,12"
                                        Padding="12,6"
                                        HorizontalOptions="Fill">
                                    <Label x:Name="LabelPreviewCategoria"
                                           Text="Sin categoría"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Resumen dinámico: Monto y Fecha en formato fila limpia -->
                        <Border BackgroundColor="#222738"
                                Stroke="#323A50"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14, 10"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                <Grid ColumnDefinitions="Auto, *" HorizontalOptions="Fill">
                                    <Label Text="Monto total:" FontAttributes="Bold" TextColor="#8E95A5" FontSize="14" VerticalOptions="Center"/>
                                    <Label x:Name="LabelPreviewMonto" Grid.Column="1" Text="$ 0,00" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="NoWrap" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#30384C" HorizontalOptions="Fill"/>
                                <Grid ColumnDefinitions="Auto, *" HorizontalOptions="Fill">
                                    <Label Text="Fecha de registro:" FontAttributes="Bold" TextColor="#8E95A5" FontSize="13" VerticalOptions="Center"/>
                                    <Label x:Name="LabelPreviewFecha" Grid.Column="1" Text="--/--/----" FontSize="13" TextColor="#B0B5C6" HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="NoWrap" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Botón Guardar Responsivo y Grande -->
                        <Button x:Name="BtnGuardar"
                                Text="Guardar ingreso" 
                                Clicked="OnGuardarClicked" 
                                BackgroundColor="#4CAF50" 
                                TextColor="White" 
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="50"
                                CornerRadius="12"
                                HorizontalOptions="Fill"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegación inferior -->
        <views:Navegador Grid.Row="1" PaginaActiva="Movimiento"/>

        <!-- Menú lateral de usuario flotante -->
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>

    </Grid>
</ContentPage>