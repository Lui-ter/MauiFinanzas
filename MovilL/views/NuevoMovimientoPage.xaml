<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MovilL.views"
             x:Class="MovilL.views.NuevoMovimientoPage"
             Title="Nuevo movimiento"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0B1020">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ToolbarUsuario"
                     IconImageSource="user.png"
                     Text="Perfil"
                     Clicked="OnUsuarioClicked"/>
    </ContentPage.ToolbarItems>

    <Grid x:Name="MainGrid" RowDefinitions="*, Auto">

        <!-- Contenido scrolleable responsivo garantizado para pantallas móviles -->
        <ScrollView Grid.Row="0" Orientation="Vertical" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="16" HorizontalOptions="Fill" Padding="16, 12">

                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="2, 4, 2, 0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Movimientos"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Registra y organiza tus ingresos y gastos"
                               FontSize="13"
                               TextColor="#8491A7"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Crear tipo&#10;movimiento"
                            SemanticProperties.Description="Crear tipo de movimiento y categoría"
                            Clicked="OnMostrarFormularioCategoriaClicked"
                            BackgroundColor="#202A3D"
                            TextColor="#68E0A3"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="42"
                            Padding="12,0"
                            CornerRadius="12"
                            VerticalOptions="Center"/>
                </Grid>

                <Border x:Name="FormularioCategoria"
                        IsVisible="False"
                        StrokeShape="RoundRectangle 18"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Crear tipo de movimiento"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                                <Label Text="Define si será ingreso o gasto y personaliza su categoría."
                                       FontSize="12"
                                       TextColor="#8491A7"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Cerrar"
                                    Clicked="OnOcultarFormularioCategoriaClicked"
                                    BackgroundColor="#202A3D"
                                    TextColor="#A6B1C5"
                                    FontSize="12"
                                    CornerRadius="10"
                                    Padding="10,0"
                                    HeightRequest="36"
                                    VerticalOptions="Start"/>
                        </Grid>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Tipo de movimiento" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48">
                                <Picker x:Name="PickerTipoCategoria"
                                        FontSize="14"
                                        TextColor="White"
                                        TitleColor="#8491A7"
                                        VerticalOptions="Center">
                                    <Picker.Items>
                                        <x:String>Ingreso</x:String>
                                        <x:String>Gasto</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre de la categoría" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48">
                                <Entry x:Name="EntryNuevaCategoria"
                                       Placeholder="Ej. Mascotas, salud, ventas"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       MaxLength="40"
                                       ReturnType="Done"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="96, *" ColumnSpacing="12">
                            <Border WidthRequest="96"
                                    HeightRequest="88"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="4">
                                <Grid>
                                    <Image x:Name="ImagePreviewNuevaCategoria"
                                           Aspect="AspectFill"
                                           IsVisible="False"/>
                                    <Label x:Name="LabelSinImagenCategoria"
                                           Text="Sin imagen"
                                           FontSize="11"
                                           TextColor="#8491A7"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="Seleccionar imagen"
                                        Clicked="OnSeleccionarImagenCategoriaClicked"
                                        BackgroundColor="#202A3D"
                                        TextColor="#68E0A3"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="42"
                                        CornerRadius="10"/>
                                <Label Text="Formatos JPG o PNG"
                                       FontSize="11"
                                       TextColor="#8491A7"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="LabelCategoriaMensaje"
                               IsVisible="False"
                               FontSize="12"
                               LineBreakMode="WordWrap"/>

                        <Button x:Name="BtnGuardarCategoria"
                                Text="Guardar categoría"
                                Clicked="OnGuardarCategoriaClicked"
                                BackgroundColor="#68E0A3"
                                TextColor="#0B2018"
                                FontAttributes="Bold"
                                FontSize="14"
                                HeightRequest="46"
                                CornerRadius="11"/>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="FormularioMovimiento" Spacing="16">

                <!-- TARJETA: FORMULARIO -->
                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="16"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">

                        <Label Text="DETALLES DE LA OPERACIÓN"
                               FontAttributes="Bold"
                               FontSize="11"
                               TextColor="#68E0A3"
                               Margin="2,0"/>

                        <!-- Tipo de movimiento -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Tipo de movimiento" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Picker x:Name="PickerTipo"
                                        FontSize="14"
                                        TextColor="White"
                                        TitleColor="#8491A7"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="OnTipoChanged">
                                    <Picker.Items>
                                        <x:String>Ingreso</x:String>
                                        <x:String>Gasto</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Categoría -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Categoría" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Picker x:Name="PickerCategoria"
                                        ItemDisplayBinding="{Binding Nombre}"
                                        FontSize="14"
                                        TextColor="White"
                                        TitleColor="#8491A7"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Center"
                                        SelectedIndexChanged="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Monto -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Monto ($)" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <Entry x:Name="EntryMonto"
                                       Placeholder="0.00"
                                       PlaceholderColor="#71809A"
                                       TextColor="White"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Center"
                                       TextChanged="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fecha -->
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Fill">
                            <Label Text="Fecha" FontAttributes="Bold" FontSize="13" TextColor="#A6B1C5"/>
                            <Border StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#0E1524"
                                    Stroke="#303B53"
                                    StrokeThickness="1"
                                    Padding="12,0"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Fill">
                                <DatePicker x:Name="DatePickerFecha"
                                            TextColor="White"
                                            FontSize="14"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Center"
                                            DateSelected="OnFormularioChanged"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Mensaje de estado -->
                        <Label x:Name="LabelMensaje"
                               TextColor="#49CE8D"
                               FontSize="13"
                               FontAttributes="Bold"
                               IsVisible="False"
                               HorizontalOptions="Fill"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               Margin="0, 4, 0, 0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- TARJETA: VISTA PREVIA Y CONFIRMACIÓN -->
                <Border StrokeShape="RoundRectangle 18"
                        BackgroundColor="#141B2B"
                        Stroke="#28334B"
                        StrokeThickness="1"
                        Padding="16"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">

                        <Grid ColumnDefinitions="*, Auto" HorizontalOptions="Fill">
                            <Label Text="VISTA PREVIA EN VIVO"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="#8491A7"
                                   VerticalOptions="Center"/>
                            <Label x:Name="LabelPreviewTipo"
                                   Grid.Column="1"
                                   Text="INGRESO"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="#49CE8D"
                                   HorizontalOptions="End"
                                   HorizontalTextAlignment="End"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <!-- Cuadro con la Imagen ocupando todo el ancho de forma responsiva -->
                        <Border x:Name="BorderIcono"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="#0E1524"
                                Stroke="#49CE8D"
                                StrokeThickness="2"
                                HeightRequest="140"
                                MinimumHeightRequest="140"
                                MaximumHeightRequest="140"
                                HorizontalOptions="Fill"
                                Padding="0">
                            <Grid HeightRequest="140" HorizontalOptions="Fill" IsClippedToBounds="True">
                                <Image x:Name="ImagePreviewCategoria"
                                       Aspect="AspectFill"
                                       HeightRequest="140"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill"/>

                                <!-- Barra inferior con el nombre de la categoría -->
                                <Border VerticalOptions="End"
                                        BackgroundColor="#E6161924"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 0,0,12,12"
                                        Padding="12,6"
                                        HorizontalOptions="Fill">
                                    <Label x:Name="LabelPreviewCategoria"
                                           Text="Sin categoría"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Resumen dinámico: Monto y Fecha en formato fila limpia -->
                        <Border BackgroundColor="#0E1524"
                                Stroke="#303B53"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14, 10"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                <Grid ColumnDefinitions="Auto, *" HorizontalOptions="Fill">
                                    <Label Text="Monto total:" FontAttributes="Bold" TextColor="#8491A7" FontSize="14" VerticalOptions="Center"/>
                                    <Label x:Name="LabelPreviewMonto" Grid.Column="1" Text="$ 0,00" FontAttributes="Bold" FontSize="17" TextColor="White" HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="NoWrap" VerticalOptions="Center"/>
                                </Grid>
                                <BoxView HeightRequest="1" Color="#303B53" HorizontalOptions="Fill"/>
                                <Grid ColumnDefinitions="Auto, *" HorizontalOptions="Fill">
                                    <Label Text="Fecha de registro:" FontAttributes="Bold" TextColor="#8491A7" FontSize="13" VerticalOptions="Center"/>
                                    <Label x:Name="LabelPreviewFecha" Grid.Column="1" Text="--/--/----" FontSize="13" TextColor="#A6B1C5" HorizontalOptions="End" HorizontalTextAlignment="End" LineBreakMode="NoWrap" VerticalOptions="Center"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Botón Guardar Responsivo y Grande -->
                        <Button x:Name="BtnGuardar"
                                Text="Guardar ingreso"
                                Clicked="OnGuardarClicked"
                                BackgroundColor="#49CE8D"
                                TextColor="#0B2018"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="50"
                                CornerRadius="12"
                                HorizontalOptions="Fill"/>

                    </VerticalStackLayout>
                </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de navegación inferior -->
        <views:Navegador Grid.Row="1" PaginaActiva="Movimiento"/>

        <!-- Menú lateral de usuario flotante -->
        <views:Menu x:Name="MenuUsuario" Grid.RowSpan="2"/>

    </Grid>
</ContentPage>